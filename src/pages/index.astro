---
import App from '../main.jsx';
import '../styles.css';
import openingCover from '../../assets/opening-cover.png';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#702c3b" />
    <meta name="description" content="The wedding celebration of Shrishti Sikarwar and Jaydeep Singh Thakur." />
    <title>Shrishti & Jaydeep — 12 December 2026</title>
  </head>
  <body>
    <div class="entry" id="entry" aria-label="Wedding invitation cover">
      <div class="entry-panel entry-panel--top" aria-hidden="true"><img class="entry-art" src={openingCover.src} alt="" /></div>
      <div class="entry-panel entry-panel--bottom" aria-hidden="true"><img class="entry-art" src={openingCover.src} alt="" /></div>
      <button class="entry-trigger" id="open-invitation" aria-label="Open Shrishti and Jaydeep's wedding invitation">
        <span class="entry-sparkles" aria-hidden="true"></span>
        <span class="sr-only">Tap to open the invitation</span>
      </button>
    </div>
    <App client:load />
    <script>
      const entry = document.querySelector('#entry');
      document.querySelector('#open-invitation')?.addEventListener('click', () => {
        entry?.classList.add('is-loading');
        window.setTimeout(() => {
          entry?.classList.add('is-opening');
        }, 850);
        window.setTimeout(() => {
          const openWelcome = () => {
            const seal = document.querySelector<HTMLButtonElement>('.seal');
            if (seal) seal.click();
            else window.setTimeout(openWelcome, 100);
          };
          openWelcome();
        }, 1380);
        window.setTimeout(() => entry?.classList.add('is-gone'), 1700);
      }, { once: true });
      document.querySelector('nav a[href="#invitation"]')?.setAttribute('href', '#welcome');
      document.querySelector('.hero-copy a[href="#invitation"]')?.setAttribute('href', '#celebrations');
      const setupScrollReveal = () => {
        const revealItems = document.querySelectorAll<HTMLElement>('.count, .celebrations, .venue, .rsvp, .closing, footer');
        if (!revealItems.length) {
          window.setTimeout(setupScrollReveal, 120);
          return;
        }
        revealItems.forEach((item) => item.classList.add('reveal-on-scroll'));
        const revealOnScroll = () => {
          revealItems.forEach((item) => {
            if (item.getBoundingClientRect().top < window.innerHeight * .9) item.classList.add('is-visible');
          });
        };
        window.addEventListener('scroll', revealOnScroll, { passive: true });
        revealOnScroll();
        if (!('IntersectionObserver' in window)) {
          revealItems.forEach((item) => item.classList.add('is-visible'));
          return;
        }
        const revealObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          });
        }, { threshold: 0.16, rootMargin: '0px 0px -8% 0px' });
        revealItems.forEach((item) => revealObserver.observe(item));
      };
      setupScrollReveal();
    </script>
  </body>
</html>

<style is:global>
  .entry{position:fixed;inset:0;z-index:50;overflow:hidden;background:#f8f4ec}.entry-panel{position:absolute;left:0;width:100%;height:50.1%;overflow:hidden;background:#f8f4ec;will-change:transform;transition:transform 900ms cubic-bezier(.77,0,.18,1)}.entry-panel--top{top:0}.entry-panel--bottom{bottom:0}.entry-art{position:absolute;left:0;width:100vw;height:100vh;max-width:none;object-fit:cover}.entry-panel--top .entry-art{top:0}.entry-panel--bottom .entry-art{bottom:0}.entry-trigger{position:absolute;inset:0;z-index:2;border:0;background:transparent;cursor:pointer}.entry-trigger:before,.entry-trigger:after{content:'';position:absolute;left:50%;top:50%;border-radius:50%;pointer-events:none;opacity:0;transform:translate(-50%,-50%)}.entry-trigger:before{width:min(31vw,330px);height:min(31vw,330px);border:4px solid #f5d58d3d;border-top-color:#fff7d8;border-right-color:#c69445;box-shadow:0 0 18px #f5d58dcc,0 0 50px #f5d58d88,0 0 110px #fff8d855}.entry-trigger:after{width:12px;height:12px;background:#fff8d8;box-shadow:0 0 16px 6px #f5d58d,0 0 42px 15px #f5d58d88}.entry-trigger:focus-visible{outline:3px solid #702c3b;outline-offset:-16px}.entry.is-loading .entry-trigger:before{opacity:1;animation:entry-spinner 1.05s linear infinite}.entry.is-loading .entry-trigger:after{opacity:1;animation:entry-shimmer 1.05s ease-in-out infinite}.entry.is-opening .entry-trigger:before{opacity:0;animation:none}.entry.is-opening .entry-trigger:after{opacity:0;animation:none}.entry.is-opening .entry-panel--top{transform:translateY(-105%)}.entry.is-opening .entry-panel--bottom{transform:translateY(105%)}.entry.is-opening .entry-trigger{pointer-events:none}.entry.is-gone{display:none}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}@keyframes entry-spinner{to{transform:translate(-50%,-50%) rotate(360deg)}}@keyframes entry-shimmer{0%,100%{transform:translate(-50%,-50%) scale(.65);opacity:.45}50%{transform:translate(-50%,-50%) scale(1.6);opacity:1}}@media(prefers-reduced-motion:reduce){.entry-panel{transition-duration:1ms}.entry-trigger:before,.entry-trigger:after{animation:none!important}}
</style>

<style is="global">
  .entry-trigger:before{width:min(58vw,560px);height:min(58vw,560px)}
  .entry-sparkles{position:absolute;left:50%;top:50%;width:5px;height:5px;border-radius:50%;opacity:0;background:#fff6c9;box-shadow:calc(-28vw) -17vw 0 1px #e9c16f,calc(25vw) -15vw 0 #fff6c9,calc(29vw) 18vw 0 1px #e9c16f,calc(-25vw) 20vw 0 #fff6c9,calc(2vw) -28vw 0 1px #e9c16f,calc(-4vw) 28vw 0 #fff6c9;transform:translate(-50%,-50%)}
  .entry.is-loading .entry-sparkles{opacity:.9;animation:sparkle-twinkle 1.15s ease-in-out infinite}
  .entry.is-opening .entry-sparkles{opacity:0;animation:none}
  @keyframes sparkle-twinkle{0%,100%{filter:brightness(.75);transform:translate(-50%,-50%) scale(.8)}50%{filter:brightness(1.5);transform:translate(-50%,-50%) scale(1.15)}}
  @media(prefers-reduced-motion:reduce){.entry-sparkles{animation:none!important}}
</style>

<style is:global>
  .invitation{display:none}
  .story,.gallery{display:none}
  nav a[href="#story"],nav a[href="#gallery"]{display:none}
  .hero-copy:after{content:'With the blessings of the Almighty and the love of our families, we invite you to join us as Shrishti and Jaydeep begin their beautiful journey together.';display:block;max-width:540px;margin:26px auto 0;color:#fffaf0;font:15px/1.65 'DM Sans',sans-serif;text-shadow:0 2px 10px #352018;}
  @media(max-width:600px){.hero-copy:after{max-width:320px;font-size:13px;line-height:1.55;margin-top:20px}}
</style>

<style is:global>
  .entry{background:#f8f4ec}
  .entry{height:100vh;min-height:0}
  .entry-panel{height:calc(50% + 1px);z-index:1}
  .entry-panel--top{z-index:2}
  .entry-art{display:block}
  .entry-art{height:100vh;object-position:center center}
  @supports (height:100dvh){.entry{height:100dvh}.entry-art{height:100dvh}}
  .hero h1{white-space:nowrap;font-size:clamp(3.2rem,9vw,8.5rem)}
  .hero h1 i{display:inline-block;margin:0 .1em;vertical-align:middle}
  .closing>span{display:none}
  .seal-page:before,.seal-page:after{content:'';position:absolute;left:50%;top:calc(50% - 26px);border-radius:50%;pointer-events:none;transform:translate(-50%,-50%)}
  .seal-page:before{width:min(76vw,452px);height:min(76vw,452px);border:1px solid #c5a46d; border-top-color:transparent;border-bottom-color:#e5c389;box-shadow:0 0 0 8px #c5a46d18,0 0 32px #c5a46d42;animation:seal-orbit 9s linear infinite}
  .seal-page:after{width:min(66vw,398px);height:min(66vw,398px);border:1px dashed #e5c38980;animation:seal-orbit-reverse 14s linear infinite}
  .seal-page.leave:before,.seal-page.leave:after{animation-play-state:paused}
  @keyframes seal-orbit{to{transform:translate(-50%,-50%) rotate(360deg)}}
  @keyframes seal-orbit-reverse{to{transform:translate(-50%,-50%) rotate(-360deg)}}
  @media(max-width:520px){.hero h1{font-size:clamp(2.8rem,13vw,4.3rem)}}
</style>

<style is="global">
  @keyframes content-rise{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:none}}
  @keyframes soft-float{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
  .show nav{animation:content-rise .7s .08s both}
  .show .hero-copy>*{animation:content-rise .8s both}
  .show .hero-copy>*:nth-child(1){animation-delay:.16s}.show .hero-copy>*:nth-child(2){animation-delay:.24s}.show .hero-copy>*:nth-child(3){animation-delay:.32s}.show .hero-copy>*:nth-child(4){animation-delay:.4s}.show .hero-copy>*:nth-child(5){animation-delay:.48s}.show .hero-copy>*:nth-child(6){animation-delay:.56s}.show .hero-copy>*:nth-child(7){animation-delay:.64s}
  .show .hero:after{animation:hero-frame 1.4s .2s both}
  .show .hero h1 i{animation:soft-float 3.2s 1.2s ease-in-out infinite}
  .show .hero-copy>p:first-child{animation-delay:.12s}
  .show .hero-copy>span{animation-delay:.28s}
  .show .hero-copy>h1{animation:hero-title-in 1s .42s both}
  .show .hero-copy>p:nth-of-type(2){animation-delay:.7s}
  .show .hero-copy>b:nth-of-type(1){animation-delay:.84s}
  .show .hero-copy>b:nth-of-type(2){animation-delay:.98s}
  .show .hero-copy>.button{animation-delay:1.14s}
  .show .count,.show .celebrations,.show .venue,.show .rsvp,.show .closing,.show footer{animation:content-rise .8s .22s both}
  .show .function{animation:content-rise .7s both}
  .show .function:nth-child(1){animation-delay:.18s}.show .function:nth-child(2){animation-delay:.26s}.show .function:nth-child(3){animation-delay:.34s}.show .function:nth-child(4){animation-delay:.42s}.show .function:nth-child(5){animation-delay:.5s}
  @keyframes hero-frame{from{opacity:0;transform:scale(.97)}to{opacity:1;transform:scale(1)}}
  @keyframes hero-title-in{from{opacity:0;transform:translateY(28px) scale(.94);letter-spacing:.12em}to{opacity:1;transform:none;letter-spacing:normal}}
  .reveal-on-scroll{opacity:0!important;transform:translateY(34px);animation:none!important;transition:opacity .8s ease,transform .8s cubic-bezier(.2,.75,.25,1)}
  .reveal-on-scroll.is-visible{opacity:1!important;transform:none}
  .reveal-on-scroll.is-visible .function{animation:content-rise .7s both}
  .reveal-on-scroll.is-visible .function:nth-child(1){animation-delay:.08s}.reveal-on-scroll.is-visible .function:nth-child(2){animation-delay:.18s}.reveal-on-scroll.is-visible .function:nth-child(3){animation-delay:.28s}.reveal-on-scroll.is-visible .function:nth-child(4){animation-delay:.38s}.reveal-on-scroll.is-visible .function:nth-child(5){animation-delay:.48s}
  .reveal-on-scroll.is-visible .time div{animation:content-rise .6s both}
  .reveal-on-scroll.is-visible .time div:nth-child(1){animation-delay:.08s}.reveal-on-scroll.is-visible .time div:nth-child(2){animation-delay:.18s}.reveal-on-scroll.is-visible .time div:nth-child(3){animation-delay:.28s}.reveal-on-scroll.is-visible .time div:nth-child(4){animation-delay:.38s}
  @media(prefers-reduced-motion:reduce){.reveal-on-scroll{opacity:1!important;transform:none;transition:none}.reveal-on-scroll.is-visible .function,.reveal-on-scroll.is-visible .time div{animation:none!important}}
  @media(prefers-reduced-motion:reduce){.seal-page:before,.seal-page:after,.show nav,.show .hero-copy>*,.show .hero:after,.show .count,.show .celebrations,.show .venue,.show .rsvp,.show .closing,.show footer,.show .function{animation:none!important}}
</style>
