---
import App from '../main.jsx';
import '../styles.css';
import royalEmblem from '../../assets/royal-emblem.png';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#702c3b" />
    <meta name="description" content="The wedding celebration of Shrishti Sikarwar and Jaydeep Singh Thakur." />
    <title>Shrishti & Jaydeep — 12 December 2026</title>
  </head>
  <body>
    <div class="entry" id="entry" aria-label="Wedding invitation cover" style={`--emblem: url(${royalEmblem.src})`}>
      <div class="entry-panel entry-panel--top" aria-hidden="true"></div>
      <div class="entry-panel entry-panel--bottom" aria-hidden="true"></div>
      <button class="entry-trigger" id="open-invitation" aria-label="Open Shrishti and Jaydeep's wedding invitation">
        <span class="sr-only">Tap to open the invitation</span>
      </button>
    </div>
    <App client:load />
    <script>
      const entry = document.querySelector('#entry');
      document.querySelector('#open-invitation')?.addEventListener('click', () => {
        entry?.classList.add('is-opening');
        window.setTimeout(() => {
          entry?.classList.add('is-gone');
          document.querySelector<HTMLButtonElement>('.seal')?.click();
        }, 900);
      }, { once: true });
    </script>
  </body>
</html>

<style is:global>
  .entry{position:fixed;inset:0;z-index:50;overflow:hidden;background:#f8f4ec}.entry-panel{position:absolute;left:0;width:100%;height:50.1%;background-color:#f8f4ec;background-image:var(--emblem);background-repeat:no-repeat;background-size:auto 100vh;will-change:transform;transition:transform 900ms cubic-bezier(.77,0,.18,1)}.entry-panel--top{top:0;background-position:center top}.entry-panel--bottom{bottom:0;background-position:center bottom}.entry-trigger{position:absolute;inset:0;z-index:2;border:0;background:transparent;cursor:pointer}.entry-trigger:focus-visible{outline:3px solid #702c3b;outline-offset:-16px}.entry.is-opening .entry-panel--top{transform:translateY(-105%)}.entry.is-opening .entry-panel--bottom{transform:translateY(105%)}.entry.is-opening .entry-trigger{pointer-events:none}.entry.is-gone{display:none}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}@media(prefers-reduced-motion:reduce){.entry-panel{transition-duration:1ms}}
</style>
