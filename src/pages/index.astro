---
import App from '../main.jsx';
import '../styles.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#702c3b" />
    <meta name="description" content="The wedding celebration of Shrishti Sikarwar and Jaydeep Singh Thakur." />
    <title>Shrishti & Jaydeep — 12 December 2026</title>
  </head>
  <body>
    <div class="entry" id="entry" aria-label="Wedding invitation cover">
      <div class="entry-panel entry-panel--top" aria-hidden="true"></div>
      <div class="entry-panel entry-panel--bottom" aria-hidden="true"></div>
      <button class="entry-trigger" id="open-invitation" aria-label="Open Shrishti and Jaydeep's wedding invitation">
        <span class="entry-emblem" aria-hidden="true"><b>J</b><i>&amp;</i><b>S</b></span>
        <span class="entry-label">Tap to open the invitation</span>
        <span class="sr-only">Tap to open the invitation</span>
      </button>
    </div>
    <App client:load />
    <script>
      const entry = document.querySelector('#entry');
      document.querySelector('#open-invitation')?.addEventListener('click', () => {
        entry?.classList.add('is-opening');
        window.setTimeout(() => {
          document.querySelector<HTMLButtonElement>('.seal')?.click();
        }, 680);
        window.setTimeout(() => entry?.classList.add('is-gone'), 900);
      }, { once: true });
      document.querySelector('nav a[href="#invitation"]')?.setAttribute('href', '#welcome');
      document.querySelector('.hero-copy a[href="#invitation"]')?.setAttribute('href', '#celebrations');
    </script>
  </body>
</html>

<style is:global>
  .entry{position:fixed;inset:0;z-index:50;overflow:hidden;background:#f8f4ec}.entry-panel{position:absolute;left:0;width:100%;height:50.1%;opacity:0;background:#fbf7ef;border:1px solid #c5a46d;box-shadow:inset 0 0 0 12px #fbf7ef,inset 0 0 0 14px #c5a46d;will-change:transform,opacity;transition:transform 900ms cubic-bezier(.77,0,.18,1),opacity 180ms ease}.entry-panel--top{top:0}.entry-panel--bottom{bottom:0}.entry-trigger{position:absolute;inset:0;z-index:2;border:0;background:transparent;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:24px;cursor:pointer}.entry-emblem{width:min(48vw,320px);aspect-ratio:1;border-radius:50%;display:flex;align-items:center;justify-content:center;gap:8px;background:#702c3b;border:2px solid #c5a46d;outline:1px solid #c5a46d;outline-offset:-12px;box-shadow:0 0 0 13px #f8f4ec,0 0 0 15px #c5a46d,0 20px 60px #702c3b2e;color:#f8f4ec;transition:transform .4s ease}.entry-emblem b{font:clamp(4rem,12vw,7rem)/1 'Cormorant Garamond',serif;font-weight:500}.entry-emblem i{font:clamp(2rem,6vw,4rem)/1 'Great Vibes',cursive;font-style:normal;color:#e4c382}.entry-trigger:hover .entry-emblem{transform:scale(1.035)}.entry-label{font:10px 'DM Sans',sans-serif;letter-spacing:.2em;text-transform:uppercase;color:#702c3b}.entry-trigger:focus-visible{outline:3px solid #702c3b;outline-offset:-16px}.entry.is-opening .entry-panel{opacity:1}.entry.is-opening .entry-panel--top{transform:translateY(-105%)}.entry.is-opening .entry-panel--bottom{transform:translateY(105%)}.entry.is-opening .entry-trigger{pointer-events:none}.entry.is-opening .entry-emblem{transform:scale(.9);opacity:0}.entry.is-gone{display:none}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}@media(max-width:520px){.entry-emblem{width:min(64vw,280px)}}@media(prefers-reduced-motion:reduce){.entry-panel{transition-duration:1ms}.entry-emblem{transition:none}}
</style>

<style is:global>
  .invitation{display:none}
  .story,.gallery{display:none}
  nav a[href="#story"],nav a[href="#gallery"]{display:none}
  .hero-copy:after{content:'With the blessings of the Almighty and the love of our families, we invite you to join us as Shrishti and Jaydeep begin their beautiful journey together.';display:block;max-width:540px;margin:26px auto 0;color:#fffaf0;font:15px/1.65 'DM Sans',sans-serif;text-shadow:0 2px 10px #352018;}
  @media(max-width:600px){.hero-copy:after{max-width:320px;font-size:13px;line-height:1.55;margin-top:20px}}
</style>

<style is:global>
  .entry{background-color:#f4ebe1;background-image:radial-gradient(circle at 18% 22%,#d5ae7d18 0 1px,transparent 1.5px),radial-gradient(circle at 72% 74%,#702c3b0d 0 1px,transparent 1.5px),linear-gradient(135deg,#fbf7ef 0%,#f1e2d8 48%,#f8f0e6 100%);background-size:11px 11px,17px 17px,100% 100%}
  .entry-trigger{gap:42px}
  .entry-emblem{width:min(52vw,360px)}
  .entry-label{margin-top:3px;letter-spacing:.26em}
</style>
